
/* =========================================
   KOPIHUB - GLOBAL FOOTER LOADER
========================================= */

(() => {

  "use strict";

  const FOOTER_HTML =
    "/kopihub/components/footer.html";

  const FOOTER_CSS =
    "/kopihub/css/footer.css";

  const SUPABASE_URL =
    "https://ozcliasebeydgyvgluht.supabase.co";

  const SUPABASE_KEY =
    "sb_publishable_X3z6XFroL-eNdwB14y6dYw_81dvj1yN";


  /* =========================================
     MEMUAT CSS FOOTER
  ========================================= */

  function loadFooterCSS() {

    if (
      document.querySelector(
        'link[data-kopihub-footer-css]'
      )
    ) {
      return;
    }

    const link = document.createElement("link");

    link.rel = "stylesheet";
    link.href = FOOTER_CSS;
    link.dataset.kopihubFooterCss = "true";

    document.head.appendChild(link);

  }


  /* =========================================
     MENGAMBIL LOGO RESMI DARI SUPABASE
  ========================================= */

  async function loadOfficialLogo(footer) {

    const logoImage = footer.querySelector(
      "#kh-footer-logo-image"
    );

    const fallback = footer.querySelector(
      "#kh-footer-logo-fallback"
    );

    if (!logoImage || !fallback) {
      return;
    }

    try {

      const response = await fetch(
        SUPABASE_URL +
        "/rest/v1/rpc/kh_get_platform_logo_path",
        {
          method: "POST",
          headers: {
            "apikey": SUPABASE_KEY,
            "Authorization": "Bearer " + SUPABASE_KEY,
            "Content-Type": "application/json"
          },
          body: "{}"
        }
      );

      if (!response.ok) {
        throw new Error(
          "Tidak berhasil mengambil logo resmi."
        );
      }

      const logoPath = await response.json();

      if (!logoPath) {
        return;
      }

      const publicLogoURL =
        SUPABASE_URL +
        "/storage/v1/object/public/platform-assets/" +
        logoPath
          .split("/")
          .map(encodeURIComponent)
          .join("/");

      logoImage.onload = () => {
        logoImage.hidden = false;
        fallback.hidden = true;
      };

      logoImage.onerror = () => {
        logoImage.hidden = true;
        fallback.hidden = false;
      };

      logoImage.src = publicLogoURL;

    } catch (error) {

      console.error(
        "KopiHub: Gagal memuat logo footer.",
        error
      );

      logoImage.hidden = true;
      fallback.hidden = false;

    }

  }


  /* =========================================
     MEMUAT FOOTER KE HALAMAN
  ========================================= */

  async function loadFooter() {

    const placeholders = document.querySelectorAll(
      "[data-kopihub-footer]"
    );

    if (!placeholders.length) {
      return;
    }

    loadFooterCSS();

    try {

      const response = await fetch(FOOTER_HTML, {
        cache: "no-cache"
      });

      if (!response.ok) {
        throw new Error(
          "File footer.html tidak ditemukan."
        );
      }

      const footerHTML = await response.text();

      placeholders.forEach((placeholder) => {

        if (
          placeholder.dataset.footerLoaded === "true"
        ) {
          return;
        }

        placeholder.innerHTML = footerHTML;

        placeholder.dataset.footerLoaded = "true";

        const footer = placeholder.querySelector(
          ".kh-global-footer"
        );

        if (!footer) {
          return;
        }

        /* Tahun otomatis */

        footer.querySelectorAll("[data-year]").forEach(
          (element) => {
            element.textContent =
              new Date().getFullYear();
          }
        );

        /* Logo resmi */

        loadOfficialLogo(footer);

      });

    } catch (error) {

      console.error(
        "KopiHub: Footer Global gagal dimuat.",
        error
      );

    }

  }


  /* =========================================
     JALANKAN FOOTER
  ========================================= */

  if (document.readyState === "loading") {

    document.addEventListener(
      "DOMContentLoaded",
      loadFooter
    );

  } else {

    loadFooter();

  }

})();
