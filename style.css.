
:root {
  --green: #123b2c;
  --green-light: #1c5940;
  --mint: #e8f2e9;
  --cream: #faf9f5;
  --orange: #e99a55;
  --text: #24342c;
  --muted: #778078;
  --white: #ffffff;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--cream);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
    Roboto, sans-serif;
  line-height: 1.6;
}

a {
  color: inherit;
  text-decoration: none;
}

.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 18px 7%;
  background: var(--white);
  border-bottom: 1px solid #e8ece7;
}

.logo {
  font-size: 25px;
  font-weight: 800;
  letter-spacing: -1px;
  color: var(--green);
}

.logo span {
  color: var(--orange);
}

.owner-link {
  color: var(--green);
  font-size: 13px;
  font-weight: 700;
}

.hero {
  padding: 75px 8% 85px;
  background: var(--green);
  color: var(--white);
  border-radius: 0 0 32px 32px;
}

.eyebrow {
  margin: 0 0 12px;
  color: var(--orange);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
}

.hero h1 {
  margin: 0;
  font-size: clamp(40px, 8vw, 64px);
  line-height: 1.12;
  letter-spacing: -2px;
}

.intro {
  max-width: 420px;
  margin: 22px 0 30px;
  color: #d8e7dd;
  font-size: 15px;
}

.primary-button {
  display: inline-block;
  padding: 13px 21px;
  border-radius: 10px;
  background: var(--orange);
  color: #242b22;
  font-size: 14px;
  font-weight: 800;
  transition: transform 0.2s, opacity 0.2s;
}

.primary-button:hover {
  transform: translateY(-2px);
  opacity: 0.92;
}

.shops {
  padding: 55px 7%;
}

.shops h2,
.partner h2 {
  margin: 0 0 10px;
  color: var(--green);
  font-size: 30px;
  line-height: 1.25;
  letter-spacing: -0.8px;
}

.muted {
  margin: 0 0 28px;
  color: var(--muted);
  font-size: 14px;
}

.shop-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.shop-card {
  overflow: hidden;
  background: var(--white);
  border: 1px solid #e9ece6;
  border-radius: 18px;
  box-shadow: 0 8px 25px rgba(18, 59, 44, 0.05);
}

.shop-image {
  display: flex;
  min-height: 145px;
  align-items: center;
  justify-content: center;
  background: #e5eee3;
  font-size: 58px;
}

.shop-image.second {
  background: #f6e9d9;
}

.shop-info {
  padding: 20px;
}

.tag {
  color: var(--green-light);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1px;
}

.shop-info h3 {
  margin: 8px 0 3px;
  color: var(--green);
  font-size: 21px;
}

.shop-info p {
  margin: 0 0 18px;
  color: var(--muted);
  font-size: 13px;
}

.menu-button {
  display: inline-block;
  color: var(--green-light);
  font-size: 13px;
  font-weight: 800;
}

.partner {
  margin: 10px 7% 55px;
  padding: 32px;
  background: var(--mint);
  border-radius: 20px;
}

.partner p {
  max-width: 500px;
  color: #536359;
  font-size: 14px;
}

.partner .primary-button {
  margin-top: 8px;
}

.small-note {
  font-size: 11px !important;
}

footer {
  padding: 30px 7%;
  background: #102e23;
  color: #d8e7dd;
  text-align: center;
}

footer .logo {
  color: var(--white);
}

footer p {
  margin: 5px 0;
  font-size: 12px;
}

@media (max-width: 600px) {
  .navbar {
    padding: 16px 5%;
  }

  .logo {
    font-size: 23px;
  }

  .owner-link {
    max-width: 125px;
    text-align: right;
  }

  .hero {
    padding: 58px 7% 65px;
    border-radius: 0 0 24px 24px;
  }

  .hero h1 {
    font-size: 43px;
  }

  .shops {
    padding: 42px 5%;
  }

  .shops h2,
  .partner h2 {
    font-size: 26px;
  }

  .shop-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .shop-image {
    min-height: 125px;
  }

  .partner {
    margin: 10px 5% 40px;
    padding: 25px 20px;
  }
}
